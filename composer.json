{
    "name": "mmoollllee/filament-media-library-extensions",
    "description": "Extensions for the Filament Media Library Pro (ralphjsmit): drag-and-drop upload zones on the MediaPicker field and its selection modal, an upload button on the field, auto-selection of freshly uploaded files, and a richer preview action (PDF iframe, keyboard navigation, policy-aware file URLs) on file tiles and the file info sidebar.",
    "keywords": [
        "laravel",
        "filament",
        "filamentphp",
        "media-library",
        "media-picker",
        "upload",
        "drag-and-drop",
        "livewire"
    ],
    "homepage": "https://github.com/mmoollllee/filament-media-library-extensions",
    "license": "MIT",
    "authors": [
        {
            "name": "Moritz Graf",
            "email": "info@moritz-graf.de",
            "homepage": "https://moritz-graf.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^11.28|^12.0|^13.0",
        "ralphjsmit/laravel-filament-media-library": "^4.1"
    },
    "require-dev": {
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Mmoollllee\\FilamentMediaLibraryExtensions\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mmoollllee\\FilamentMediaLibraryExtensions\\FilamentMediaLibraryExtensionsServiceProvider"
            ]
        }
    },
    "scripts": {
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
